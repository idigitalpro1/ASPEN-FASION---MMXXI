rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: creations
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required, immutable) - The ID of the user who created this art
    //   - type: string (required) - 'image', 'video', 'magazine'
    //   - dataUrl: string (required) - The base64 data URL
    //   - prompt: string (optional) - The prompt used
    //   - createdAt: timestamp (required, immutable) - Creation time
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function uidUnchanged() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == request.auth.uid;
    }

    function uidNotModified() {
      return !('userId' in request.resource.data) ||
        request.resource.data.userId == resource.data.userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Domain Validators
    function isValidCreation(data) {
      return hasOnlyAllowedFields(['userId', 'type', 'dataUrl', 'prompt', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 128 &&
             data.type in ['image', 'video', 'magazine'] &&
             data.dataUrl is string && data.dataUrl.size() > 0 && data.dataUrl.size() < 1000000 &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() < 5000)) &&
             data.createdAt is timestamp;
    }

    match /creations/{creationId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() &&
                    isValidCreation(request.resource.data) &&
                    request.resource.data.userId == request.auth.uid;
      allow update: if isDocOwner() &&
                    isValidCreation(request.resource.data) &&
                    areImmutableFieldsUnchanged(['userId', 'createdAt']);
      allow delete: if isDocOwner();
    }
    // Star Interactions
    function isValidStarInteraction(data) {
      return hasRequiredFields(['userId', 'itemId', 'stars', 'type', 'createdAt']) &&
             hasOnlyAllowedFields(['userId', 'userEmail', 'userName', 'itemId', 'itemUser', 'stars', 'type', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 128 &&
             data.itemId is string && data.itemId.size() > 0 && data.itemId.size() < 128 &&
             data.stars is number && data.stars >= 0 &&
             data.type == 'star' &&
             (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() < 256)) &&
             (!('userName' in data) || (data.userName is string && data.userName.size() < 128)) &&
             (!('itemUser' in data) || (data.itemUser is string && data.itemUser.size() < 128)) &&
             data.createdAt is timestamp;
    }

    match /star_interactions/{interactionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() &&
                    isValidStarInteraction(request.resource.data) &&
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Newsletter Subscribers
    match /newsletter_subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string &&
                    request.resource.data.email.size() > 3 &&
                    request.resource.data.email.size() < 256 &&
                    request.resource.data.subscribedAt is timestamp;
      allow read, update, delete: if false;
    }

    // Magazine $50 Placements
    function isValidMagazinePlacement(data) {
      return hasRequiredFields(['userId', 'designer', 'imageUrl', 'amountPaid', 'receiptId', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 128 &&
             data.designer is string && data.designer.size() > 0 && data.designer.size() < 128 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() < 1000000 &&
             data.amountPaid is number && data.amountPaid >= 0 &&
             data.receiptId is string && data.receiptId.size() > 0 && data.receiptId.size() < 64 &&
             data.createdAt is timestamp;
    }

    match /magazine_placements/{placementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    isValidMagazinePlacement(request.resource.data) &&
                    request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Catalog Items
    function isValidCatalogItem(data) {
      return hasRequiredFields(['userId', 'title', 'designer', 'imageUrl', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() < 128 &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.designer is string && data.designer.size() > 0 && data.designer.size() < 128 &&
             data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() < 1000000 &&
             data.createdAt is timestamp;
    }

    match /catalog_items/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
                    isValidCatalogItem(request.resource.data) &&
                    request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
